<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MikrotikHelper</AssemblyName>
    <RootNamespace>MikrotikHelper</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj*/**;bin*/**;publish*/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
